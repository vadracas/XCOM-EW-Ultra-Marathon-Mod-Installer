m_arrVarName="INTERCEPTOR_MENU.UFO_INTERCEPTION_PCTON"
m_arrVarFriendlyName="Détection d’un OVNI"
m_arrVarDescription="Chaque intercepteur a ce pourcentage de chance de détecter un OVNI dans n’importe quel pays du continent où il est stationné sans satellite présent. Ce pourcentage est doublé avec le projet de la fonderie.\nValeur par défaut: 4."

