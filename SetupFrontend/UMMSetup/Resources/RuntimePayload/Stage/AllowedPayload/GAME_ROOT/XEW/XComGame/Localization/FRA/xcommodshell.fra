[UIModSharedContainer]
;----------------------------------------------------------
;USING .INT (OR OTHER LOCALIZATION) FILE
;----------------------------------------------------------
;The way you should organize entries in this  section is like this:
;
;m_arrVarName="UIModManager"
;m_arrVarFriendlyName="Configurer Mod Manager"
;m_arrVarDescription=Ajuster les options du gestionnaire de mods.
;
;Lines like the above should be always coming in threes, whenever you put a line m_arrVarName it MUST be followed by m_arrVarFriendlyName and m_arrVarDescription. 
;You can make m_arrVarFriendlyName="" and m_arrVarDescription="" if you don't need them but they must be there or you will screw auto-search algorithms
;m_arrVarName=SomeName is 99% times as good as m_arrVarName="SomeName" so suit yourself. 
;The above is more relevant to descriptions:
;
;m_arrVarDescription="Some description with inline \"quote\""
;or
;m_arrVarDescription=Some description with inline "qoute"
;
;Credits - a block of lines for certain mod should start with BEGIN_ModName and end with END_ModName, just like below:

m_arrCreditsModMgr=BEGIN_UIModManager
