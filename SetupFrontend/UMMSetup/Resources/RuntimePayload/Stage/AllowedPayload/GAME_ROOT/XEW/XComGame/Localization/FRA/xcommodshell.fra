m_arrVarName="INTERCEPTOR_MENU.INTERCEPTOR_REARM_HOURSON"
m_arrVarFriendlyName="Jours pour réarmer"
m_arrVarDescription="Days to add any alien-technology-based weapon to an aircraft (Missile systems are hard-coded at 12 hours).\nDefault: 7 days."

