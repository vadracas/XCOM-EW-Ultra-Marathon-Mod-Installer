[XComLZMutator.XComSpawnAlienMutator]
USE_OVERWATCH=False
DROP_TO_COVER=true
REVEAL_SPAWN=true
MIN_DROP_DIST=9
MAX_DROP_DIST=45
ExcludeMaps=EWI_ChryssalidHive

[XComLZMutator.XComSpawnMutator]
PLAYER_PROXIMITY=29.000000
OP_PROXIMITY=32.000000
AVOID_CAPTURE_ZONES=true

[XComLZMutator.XComBombMutator]
PLAYER_PROXIMITY=8.000000
INITIAL_TIMER_VALUE=5
AVOID_CAPTURE_ZONES=True
OP_PROXIMITY=32.000000

[XComLZMutator.XComMeldSpawnMutator]
NumContainers=1
EqSlope=3.000000
EqConst=4.000000
AVOID_CAPTURE_ZONES=True
PLAYER_PROXIMITY=29.000000
OP_PROXIMITY=32.000000

